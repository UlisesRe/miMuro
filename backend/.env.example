# Copiar a .env y completar

SECRET_KEY=cambiar-en-produccion

# En producción (frontend en otro dominio, HTTPS) poner DEBUG=false:
# así las cookies salen Secure + SameSite=None y las acepta el navegador.
DEBUG=true

# Orígenes extra permitidos para CORS, separados por coma (los *.netlify.app
# ya se aceptan solos). Ej.: FRONTEND_URLS=https://mi-muro.netlify.app
FRONTEND_URLS=

# SMTP — si SMTP_HOST está vacío, el backend entra en modo desarrollo
# y imprime el código de confirmación en la consola en vez de enviar el correo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=miMuro <no-reply@tu-dominio.com>

# Confirmación de email (opcionales, valores por defecto)
CONFIRMATION_CODE_EXPIRE_MINUTES=15
CONFIRMATION_MAX_ATTEMPTS=5
CONFIRMATION_RESEND_COOLDOWN_SECONDS=60
